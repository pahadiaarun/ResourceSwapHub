# ResourceSwapHub frontend example environment. Copy to
# resourceswaphub-frontend/.env.local (not committed).

# Server-side origin of the Spring API used by Next.js rewrites
# (/api/v1/* is proxied so the HttpOnly refresh cookie stays same-origin).
# Leave unset for `npm run dev` (defaults to http://127.0.0.1:8080).
BACKEND_URL=http://127.0.0.1:8080

# Browser-side WebSocket endpoint for STOMP chat. The default derives from
# window.location (ws on http, wss on https) plus port 8080, so it only needs
# to be set when the API is not on localhost:8080.
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Public origin of the deployed site, used for canonical URLs and Open Graph
# metadata (metadataBase). Leave unset in local development.
# Planned production value: https://resourceswaphub.work.gd
NEXT_PUBLIC_SITE_URL=

# Optional Google Sign-In. Set this to the same OAuth client ID the API uses
# (GOOGLE_CLIENT_ID on the backend). The "Continue with Google" button only
# renders when both values are set. Creating the client: Google Cloud Console →
# APIs & Services → Credentials → OAuth client ID (Web application), with
# http://localhost:3000 (and later https://resourceswaphub.work.gd) as
# authorized JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
