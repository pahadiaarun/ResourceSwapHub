# ResourceSwapHub backend example environment. Copy to
# resourceswaphub-backend/.env (not committed) or export these before running
# Maven/Docker. Every value can also be left at its application.yml default
# for local development.

# PostgreSQL JDBC URL. Defaults match
# resourceswaphub-database/scripts/local-postgres.sh and docker-compose.yml
# (host port 55432).
BOOKBRIDGE_DB_URL=jdbc:postgresql://127.0.0.1:55432/bookbridge
BOOKBRIDGE_DB_USER=bookbridge
BOOKBRIDGE_DB_PASSWORD=bookbridge_dev

# Server
BOOKBRIDGE_PORT=8080

# Required in production: HS256 secret, >= 32 bytes. Generate one with:
#   openssl rand -base64 48
BOOKBRIDGE_JWT_SECRET=WsD1y+M73mhQLGaG60N2arNpJjrunT04oaFL1WTi1S8XjNCLXReE4XTYq10BPbX7

# Set to true when served over HTTPS so the refresh cookie is Secure.
# For https://resourceswaphub.work.gd set this to true.
BOOKBRIDGE_COOKIE_SECURE=false

# Origins allowed to call the REST API and to redirect after sign-out.
# Local development:
#   BOOKBRIDGE_CORS_ORIGINS=http://localhost:3000
# Production (resourceswaphub.work.gd), example:
#   BOOKBRIDGE_CORS_ORIGINS=https://resourceswaphub.work.gd
BOOKBRIDGE_FRONTEND_ORIGIN=http://localhost:3000
BOOKBRIDGE_CORS_ORIGINS=http://localhost:3000

# Where uploaded book photos are stored (filesystem in this version).
BOOKBRIDGE_STORAGE_DIR=./storage

# Optional Google Sign-In: create an OAuth client in Google Cloud Console and
# set its client ID here; the frontend picks up availability via /auth/providers.
# For the production domain, add the authorized JavaScript origin
# https://resourceswaphub.work.gd to the same OAuth client.
GOOGLE_CLIENT_ID=

# NOTE: the environment variable names above keep the internal `BOOKBRIDGE_`
# prefix on purpose — renaming them would break deployments, CI and the local
# database scripts without providing value. Only the outward-facing brand
# (ResourceSwapHub) is part of public configuration.
