# macOS
.DS_Store

# Tool artifacts
.freebuff/

# Environment files — real credentials must never be committed.
# .env.example files stay tracked.
.env
.env.*
!.env.example

# Local PostgreSQL binaries and data (resourceswaphub-database/scripts/local-postgres.sh)
resourceswaphub-database/.local/

# Logical snapshots of production data taken for backup verification.
# These contain real user rows and token hashes and must never be committed.
.prod-snapshot*/
